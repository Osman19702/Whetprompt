{
  "name": "whetprompt",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Lint, score and rewrite LLM prompts. Desktop app with a built-in local model; cloud providers optional.",
  "author": "Osman Turalioglu",
  "license": "MIT",
  "homepage": "https://www.whetprompt.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Osman19702/Whetprompt.git"
  },
  "bugs": {
    "url": "https://github.com/Osman19702/Whetprompt/issues"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.js electron/*.test.js scripts/*.test.js vite.config.test.js",
    "setup": "node scripts/setup-model.js",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:store": "npm run build && electron-builder --win appx --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux",
    "release:checksums": "node scripts/release-checksums.js",
    "check:release": "node scripts/check-release.mjs",
    "lint:prompts": "node scripts/lint-prompts.js",
    "test:acceptance": "node --test acceptance/*.acceptance.test.js",
    "test:trace": "node acceptance/trace.js",
    "test:all": "npm test && npm run test:acceptance && npm run test:trace",
    "test:report": "node acceptance/report/run.mjs",
    "visual": "node scripts/visual.mjs",
    "visual:approve": "node scripts/visual.mjs --update",
    "site:releases": "node scripts/site-releases.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-llama-cpp": "^3.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "elastishot": "^0.1.7",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "node-llama-cpp@3.20.0": true,
    "electron@44.1.1": true,
    "electron-winstaller@5.4.0": true
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.whetprompt.desktop",
    "productName": "Whetprompt",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Osman19702",
      "repo": "Whetprompt",
      "releaseType": "draft"
    },
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "package.json",
      "!server/data/**",
      "!server/*.test.js",
      "!electron/*.test.js",
      "!node_modules/node-llama-cpp/llama/localBuilds/**",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!node_modules/node-llama-cpp/templates/**",
      "!node_modules/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "afterPack": "./scripts/bundle-vcruntime.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "guid": "04364fcb-646a-5b33-9819-792e8bbde3d3"
    },
    "appx": {
      "identityName": "TuralioLabs.Whetprompt",
      "publisher": "CN=2983B22E-31A1-4704-9688-153EBAC48AD9",
      "publisherDisplayName": "Turalio Labs",
      "displayName": "Whetprompt",
      "applicationId": "Whetprompt",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.19041.0",
      "maxVersionTested": "10.0.26100.0"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
